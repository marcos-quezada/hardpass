#!/bin/sh

# hardpass-gadget - dual-configuration USB ethernet gadget (RNDIS +
# CDC-ECM offered simultaneously as alternate USB configurations),
# adapted from macmpi's xg_multi (MIT licensed), stripped of the
# serial (ACM) and mass-storage functions.
#
# Real, confirmed reasons for the departures from upstream xg_multi,
# and from this script's own earlier RNDIS-only iteration:
#
# 1. The full xg_multi composite gadget (serial + ethernet, no
#    mass-storage) caused a genuine dwc2 instability with FreeBSD
#    specifically (repeated USB_ERR_IOERROR/TIMEOUT, interface
#    flapping) on this exact hardware (Pi Zero W). A manually-built,
#    ethernet-only gadget via the same configfs mechanism was confirmed
#    stable against the same FreeBSD host. Not related to the known
#    mass-storage contention bug (raspberrypi/linux#7188) -- this
#    gadget never had a mass-storage function at all.
#
# 2. FreeBSD's cdce(4) driver (CDC-ECM) only marks link state up on
#    receiving a UCDC_N_NETWORK_CONNECTION notification from the
#    gadget -- confirmed via its own driver source
#    (sys/dev/usb/net/if_cdce.c). The Linux ECM gadget function
#    negotiates fine from its own side, so urndis's own
#    carrier_up_count-based fallback logic (upstream xg_multi's
#    ECM-first, RNDIS-as-fallback behavior) never triggers, leaving
#    FreeBSD stuck at "no carrier" with zero data flow when ECM is the
#    only option offered. FreeBSD's urndis(4) driver has no such
#    notification dependency at all (confirmed: zero mentions of
#    link_state/carrier anywhere in its source).
#
# 3. macOS has no native RNDIS driver support at all (confirmed
#    repeatedly: a plain RNDIS-only gadget never gets a network
#    interface, just a generic unmatched IOUSBHostDevice). It does
#    have native CDC-ECM support.
#
# Since FreeBSD needs RNDIS specifically and macOS needs ECM
# specifically -- not just "whichever is offered", each for its own
# concrete reason -- this script offers BOTH as separate USB
# configurations (c.1 = RNDIS, c.2 = ECM) bound to the UDC
# simultaneously. Each host's own enumeration selects whichever
# configuration its driver understands via the standard
# SET_CONFIGURATION step -- no destructive try-then-rebuild fallback
# needed. Confirmed directly: FreeBSD selects RNDIS (config c.1,
# matching its urndis(4) driver), macOS selects ECM (config c.2,
# matching its native CDC-ECM support) -- both from this exact same
# gadget, real data flow confirmed on both (ping round-trips, not just
# interface-up status).
#
# Real, hard-won methodology lesson from validating this: the dwc2
# controller can get into a degraded state after repeated same-boot
# gadget rebind/reconfigure cycles, where USB enumeration succeeds but
# zero data actually flows -- this looks identical to a genuine
# protocol/compatibility failure and caused real, wasted debugging time
# before being correctly attributed to the controller state. Always
# validate gadget changes on a truly fresh boot (power-cycled, minimal
# prior reconfiguration), not a boot that's already been through
# several test cycles.

SCRIPT="${0##*/}"
error() { echo "$SCRIPT: $1" >&2; }

! [ "$(id -u)" -eq 0 ] && { error "Please run with administrator privileges."; exit 1; }

alias _logger='logger -st "$SCRIPT"'

TIMEOUT_UDC=5
TIMEOUT_ETH=5
CONFIGFS="/sys/kernel/config/usb_gadget/$SCRIPT"

_is_eth_up() {
timeout $TIMEOUT_ETH sh <<-EOF >/dev/null 2>&1
	found_up=""
	while [ -z "\$found_up" ]; do
		for eth_iface in /sys/class/udc/"$UDC"/gadget/net/*; do
			[ -e "\$eth_iface"/carrier_up_count ] || continue
			grep -vwq "0" "\$eth_iface"/carrier_up_count 2>/dev/null && found_up=1 && break
		done
		sleep 0.2
	done
EOF
}

_setup() {
grep -q '.' "$CONFIGFS"/UDC 2>/dev/null && _logger "Gadget is already configured !" && exit 1

UDC="$( grep -l "0" /sys/class/udc/*/is_a_peripheral 2>/dev/null | \
	paste -s - | sed 's|/is_a_peripheral||g' | sed 's|/sys/class/udc/||g' )"
[ -z "$UDC" ] && _logger "No interface set in peripheral mode for gadget !" && exit 1

modprobe -r g_serial g_ether g_cdc g_multi 2>/dev/null

modprobe g_serial
UDC="$( timeout $TIMEOUT_UDC sh <<-EOF 2>/dev/null
	found=""
	while [ -z "\$found" ]; do
		for iface in $UDC; do
			grep -vq UNKNOWN /sys/class/udc/"\$iface"/current_speed 2>/dev/null && found="\$iface" && break 2
		done
		sleep 0.2
	done
	echo "\$found"
EOF
 )"
modprobe -r g_serial
[ -z "$UDC" ] && _logger "Gadget USB port is not connected !" && exit 1

_logger "Creating dual-configuration (RNDIS + ECM) USB-gadget..."

USB_VENDORID="0x1d6b"
USB_PRODUCTID="0x0104"
USB_MANUF="hardpass"
USB_PRODUCT="HardPass ethernet gadget"
USB_SERIAL="hardpass-01"
USB_MAX_POWER="250"
RNDIS_HOST_MAC="${rndis_host_mac:-f6:67:ce:b3:c0:ee}"
RNDIS_DEVICE_MAC="${rndis_dev_mac:-ea:64:2f:e8:19:9a}"
ECM_HOST_MAC="${ecm_host_mac:-f6:67:ce:b3:c0:ed}"
ECM_DEVICE_MAC="${ecm_dev_mac:-ea:64:2f:e8:19:99}"
MS_VENDOR_CODE="0xcd"
MS_QW_SIGN="MSFT100"
RNDIS_CLASS="0xef"
RNDIS_SUBCLASS="0x04"
RNDIS_PROTOCOL="0x01"
MS_COMPAT_ID="RNDIS"
MS_SUBCOMPAT_ID="5162001"

modprobe libcomposite

mkdir -p "$CONFIGFS"/strings/0x409
echo $USB_VENDORID > "$CONFIGFS"/idVendor
echo $USB_PRODUCTID > "$CONFIGFS"/idProduct
echo $USB_MANUF > "$CONFIGFS"/strings/0x409/manufacturer
echo "$USB_PRODUCT" > "$CONFIGFS"/strings/0x409/product
echo $USB_SERIAL > "$CONFIGFS"/strings/0x409/serialnumber

echo "1" > "$CONFIGFS"/os_desc/use
echo "${MS_VENDOR_CODE}" > "$CONFIGFS"/os_desc/b_vendor_code
echo "${MS_QW_SIGN}" > "$CONFIGFS"/os_desc/qw_sign

# RNDIS function -- config c.1, selected by Windows/FreeBSD (urndis)
mkdir -p "$CONFIGFS"/functions/rndis.usb0
echo "$RNDIS_HOST_MAC" > "$CONFIGFS"/functions/rndis.usb0/host_addr
echo "$RNDIS_DEVICE_MAC" > "$CONFIGFS"/functions/rndis.usb0/dev_addr
echo $RNDIS_CLASS > "$CONFIGFS"/functions/rndis.usb0/class
echo $RNDIS_SUBCLASS > "$CONFIGFS"/functions/rndis.usb0/subclass
echo $RNDIS_PROTOCOL > "$CONFIGFS"/functions/rndis.usb0/protocol
echo $MS_COMPAT_ID > "$CONFIGFS"/functions/rndis.usb0/os_desc/interface.rndis/compatible_id
echo $MS_SUBCOMPAT_ID > "$CONFIGFS"/functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id

mkdir -p "$CONFIGFS"/configs/c.1/strings/0x409
echo "RNDIS" > "$CONFIGFS"/configs/c.1/strings/0x409/configuration
echo "$USB_MAX_POWER" > "$CONFIGFS"/configs/c.1/MaxPower
ln -s "$CONFIGFS"/functions/rndis.usb0 "$CONFIGFS"/configs/c.1
ln -s "$CONFIGFS"/configs/c.1 "$CONFIGFS"/os_desc

# ECM function -- config c.2, selected by macOS/Linux (native CDC-ECM)
mkdir -p "$CONFIGFS"/functions/ecm.usb0
echo "$ECM_HOST_MAC" > "$CONFIGFS"/functions/ecm.usb0/host_addr
echo "$ECM_DEVICE_MAC" > "$CONFIGFS"/functions/ecm.usb0/dev_addr

mkdir -p "$CONFIGFS"/configs/c.2/strings/0x409
echo "CDC ECM" > "$CONFIGFS"/configs/c.2/strings/0x409/configuration
echo "$USB_MAX_POWER" > "$CONFIGFS"/configs/c.2/MaxPower
ln -s "$CONFIGFS"/functions/ecm.usb0 "$CONFIGFS"/configs/c.2

_logger "Enabling dual-configuration USB-gadget..."
echo "$UDC" > "$CONFIGFS"/UDC

if _is_eth_up; then
	# Brief settle delay: carrier_up_count going nonzero doesn't
	# guarantee the netdev is immediately ready for ifup/ip commands
	# issued by a dependent service right after this one exits --
	# confirmed via a real race on first boot (networking's boot-time
	# run found usb0 with no carrier/no IP, a manual restart
	# afterwards worked fine).
	sleep 1
	# Determine which single interface actually has a real carrier
	# (only one ever will -- whichever configuration the connected
	# host selected), and assign the static IP directly to that one
	# only. Deliberately does NOT rely on /etc/network/interfaces for
	# this -- assigning the same static IP to both potential
	# interfaces caused a real, confirmed bug: the kernel would answer
	# ARP requests inconsistently with two interfaces sharing one IP,
	# even though only one had an actual carrier, silently breaking
	# connectivity despite every interface looking correctly configured.
	HARDPASS_IP="10.18.1.19/24"
	active_iface=""
	for iface in /sys/class/udc/"$UDC"/gadget/net/*; do
		[ -e "$iface" ] || continue
		name="${iface##*/}"
		ip link set "$name" up 2>/dev/null
		if grep -vwq "0" "$iface"/carrier_up_count 2>/dev/null; then
			active_iface="$name"
		fi
	done
	if [ -n "$active_iface" ]; then
		ip addr add "$HARDPASS_IP" dev "$active_iface" 2>/dev/null
		_logger "Assigned $HARDPASS_IP to $active_iface (active configuration)"
	fi
	_logger "Gadget is now setup."
else
	_remove
	_logger "Gadget setup failed, exiting."
	exit 1
fi
}

_remove() {
if grep -q '.' "$CONFIGFS"/UDC 2>/dev/null; then
	_logger "Removing gadget configuration..."
	echo "" > "$CONFIGFS"/UDC
	rm -f "$CONFIGFS"/os_desc/c.1 >/dev/null 2>&1
	rm -f "$CONFIGFS"/configs/c.1/rndis.usb0 >/dev/null 2>&1
	rm -f "$CONFIGFS"/configs/c.2/ecm.usb0 >/dev/null 2>&1
	rmdir "$CONFIGFS"/configs/c.1/strings/0x409 >/dev/null 2>&1
	rmdir "$CONFIGFS"/configs/c.1 >/dev/null 2>&1
	rmdir "$CONFIGFS"/configs/c.2/strings/0x409 >/dev/null 2>&1
	rmdir "$CONFIGFS"/configs/c.2 >/dev/null 2>&1
	rmdir "$CONFIGFS"/functions/rndis.usb0 >/dev/null 2>&1
	rmdir "$CONFIGFS"/functions/ecm.usb0 >/dev/null 2>&1
	rmdir "$CONFIGFS"/strings/0x409 >/dev/null 2>&1
	rmdir "$CONFIGFS" >/dev/null 2>&1
	_logger "Gadget is now removed."
else
	_logger "No gadget is configured !"
	exit 1
fi
}

usage() {
[ "$2" ] && error "$2"
local outfh=2
[ "$1" -eq 0 ] && outfh=1
cat >&$outfh <<-__EOF__

usage: hardpass-gadget
       hardpass-gadget -r

Setup (or remove) a dual-configuration USB gadget (RNDIS + CDC-ECM,
offered simultaneously as alternate configurations). No serial, no
mass-storage -- see header comment for why.

Options: -r|--remove                Remove gadget
         -h|--help                  Help information and usage

__EOF__
exit "$1"
}

OPTS=$(getopt -l help,remove -n "$SCRIPT" -o hr -- "$@") || usage 1
eval set -- "$OPTS"
while true; do
	case "$1" in
		-h|--help) echo "$SCRIPT"; usage 0;;
		-r|--remove) action="remove";;
		--) break;;
	esac
	shift
done

if ! [ "$action" = "remove" ]; then
	_setup
else
	_remove
fi
